<UserControl x:Class="ComputerShopManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ComputerShopManagement.Controls"
             xmlns:viewmodels="clr-namespace:ComputerShopManagement.ViewModels">
    <UserControl.DataContext>
        <viewmodels:DashboardViewModel/>
    </UserControl.DataContext>
    
    <Grid Margin="30,30">
        <ItemsControl ItemsSource="{Binding PcSessions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="260" Height="280" 
                            Background="#FF36393E"
                            CornerRadius="12"
                            Margin="0,0,20,20"
                            BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                        <Setter Property="BorderBrush" Value="{StaticResource ActiveGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="BorderBrush" Value="{StaticResource OfflineGrayBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="OrderPending">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningYellowBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <Grid>
                            <!-- Three Dots Menu -->
                            <Button Style="{StaticResource CardMenuButtonStyle}" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    x:Name="MenuButton">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add 30 mins" 
                                                  Command="{Binding DataContext.Add30MinutesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF00D9FF"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Add 1 Hour" 
                                                  Command="{Binding DataContext.Add1HourCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF00D9FF"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="End Session" 
                                                  Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF4444"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.Click">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="ContextMenu.IsOpen">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static System:Boolean.TrueString}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>

                            <!-- Order Icon for Pending Orders -->
                            <Border Width="40" Height="40" 
                                    Background="#FF2C2F33"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="15,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="OrderPending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" 
                                           FontSize="20" Foreground="{StaticResource WarningYellowBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Circular Progress -->
                                <controls:CircularProgressBar 
                                    Width="180" 
                                    Height="180"
                                    Progress="{Binding Progress}"
                                    Status="{Binding Status}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PcName}" 
                                                   FontSize="28" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedTime}" 
                                                   FontSize="14" 
                                                   Foreground="#FFB9BBBE"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock FontSize="11" 
                                                   Foreground="{StaticResource WarningYellowBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   Text="- ORDER PENDING">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OrderPending">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </controls:CircularProgressBar>

                                <!-- User Info -->
                                <TextBlock Margin="0,15,0,0" 
                                           HorizontalAlignment="Center">
                                    <Run Text="User: " Foreground="#FF8E9297" FontSize="13"/>
                                    <Run Text="{Binding UserName}" Foreground="White" FontSize="13"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
